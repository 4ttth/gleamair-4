# ─── Gleamair Portal — environment variables ────────────────────────────────
# Copy the NAMES into Vercel → Project → Settings → Environment Variables.
# Never commit real values. This file must only ever contain placeholders.

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# Restrict the database user to this database only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gleamair

# PayMongo. The SECRET key must exist ONLY here — never in any file under
# assets/ or in any .html page. Rotate it in the PayMongo dashboard if it is
# ever pasted into chat, email, or a screenshot.
# Value starts with "sk_" followed by "live_" or "test_". Leave blank here.
PAYMONGO_SECRET_KEY=

# Webhook signing secret. Created when you register the webhook endpoint --
# see docs/DEPLOYMENT.md, step 5. Starts with whsk_.
PAYMONGO_WEBHOOK_SECRET=

# Comma-separated PayMongo payment methods to offer at checkout.
# IMPORTANT: every method listed here must be ACTIVATED on your PayMongo
# account or checkout session creation fails. Start with 'card' and add the
# others once they are approved.
PAYMONGO_METHODS=card,gcash,paymaya

# Optional. The price range admins may set, in centavos. Defaults to
# PHP 1.00 - PHP 1,000,000.00. PayMongo enforces its own per-transaction
# minimum on top of this, which varies by payment method and account: if a
# price is below it, the charge is refused at checkout and the fix is to raise
# the price. Raise PAYMONGO_MIN_AMOUNT to your account's real floor to have
# that caught in the admin form instead.
# PAYMONGO_MIN_AMOUNT=100
# PAYMONGO_MAX_AMOUNT=100000000

# Public origin of the deployed site, used to build PayMongo return URLs.
# Must be the CANONICAL domain, not one that 308-redirects to it: PayMongo
# does not follow redirects. Check with: curl -sI https://your-domain/
# No trailing slash.
PUBLIC_BASE_URL=https://gleamaire.com

# One-time token that authorises creating the FIRST superadmin account via
# POST /api/bootstrap. Generate with: openssl rand -hex 32
# Delete this variable from Vercel once the first superadmin exists.
BOOTSTRAP_TOKEN=

# Optional. Geocoding for the booking map, which opens on the customer's own
# barangay rather than on the office. Defaults to OpenStreetMap's Nominatim,
# which needs no key or account. Results are cached in the `geocache`
# collection, so a locality is looked up once and then served from the
# database — Nominatim's usage policy asks for exactly that.
# Point GEOCODER_URL at your own instance or a paid provider with the same
# response shape if lookup volume outgrows the public service.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
#
# How the deployment identifies itself to the geocoder. Nominatim requires a
# contactable User-Agent and blocks anonymous traffic; set this to the site
# URL or an ops email address.
# GEOCODER_CONTACT=https://www.gleamaire.com

# ─── Later: Odoo merge (not used yet) ───────────────────────────────────────
# Left here so the sync script has a documented home when we wire Odoo up.
# ODOO_URL=https://gleamair-enterprises-opc.odoo.com
# ODOO_DB=
# ODOO_USERNAME=
# ODOO_API_KEY=
